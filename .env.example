# OllCLin - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores

# ============================================================
# SUPABASE (Banco de dados PostgreSQL)
# ============================================================
# Frontend (cliente) - exposto ao navegador
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# Backend (servidor) - NUNCA expor no frontend
# Obtenha em: Supabase Dashboard → Settings → API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_aqui
SUPABASE_SECRET_KEY=sb_secret_sua_chave_secreta_aqui
SUPABASE_JWKS_URL=https://seu-projeto.supabase.co/auth/v1/.well-known/jwks.json

# ============================================================
# GOOGLE CALENDAR API (Integração de agenda - SERVER-SIDE)
# ============================================================
# Crie um "OAuth 2.0 Client ID" do tipo Web no Google Cloud Console.
# Em "Authorized redirect URIs" cadastre exatamente:
#   ${PUBLIC_URL}/api/google-calendar/callback
# Ex.: http://localhost:3000/api/google-calendar/callback
#
# Os tokens são trocados e guardados CIFRADOS no backend. O navegador nunca
# recebe access_token/refresh_token e não precisa de VITE_GOOGLE_*.
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret-do-google-cloud

# URL pública do app (usada no redirect do OAuth e no retorno à Agenda).
# Em produção use https://seu-dominio.com (sem barra no final).
PUBLIC_URL=http://localhost:3000
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo

# Chave usada para cifrar (AES-256-GCM) os tokens do Google no banco.
# Recomendado definir uma chave própria; se vazio, deriva da SUPABASE_SECRET_KEY.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Segredo opcional para assinar o `state` do OAuth (padrão: chave acima).
GOOGLE_OAUTH_STATE_SECRET=

# ============================================================
# MANUS / OAUTH (Autenticação existente do template)
# ============================================================
MANUS_PROJECT_id=seu-project-id
MANUS_JWT_SECRET=seu-jwt-secret
MANUS_OAUTH_API_URL=https://oauth-api-url
MANUS_API_URL=https://api-url
MANUS_API_KEY=sua-api-key
MANUS_API_BROWSER_KEY=sua-chave-browser

# ============================================================
# BANCO DE DADOS (Drizzle / MySQL - legado)
# ============================================================
# DATABASE_URL (PostgreSQL / Supabase pooler). A senha deve ser URL-encodada.
# Formato: postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ============================================================
# OUTRAS CONFIGURAÇÕES
# ============================================================
PORT=3000
NODE_ENV=development
OWNER_OPEN_ID=seu-open-id-do-proprietario

# ============================================================
# MODO LOCAL DE DESENVOLVIMENTO (LGPD / SEGURANÇA)
# ============================================================
# Permite acessar o sistema sem OAuth enquanto a autenticação real não existe.
# Deixe false (ou remova) em produção.
ALLOW_DEV_AUTH=false